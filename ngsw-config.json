{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "importScripts": ["notification-sync.js"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/manifest.webmanifest",
          "/notification-sync.js",
          "/robots.txt",
          "/sitemap.xml",
          "/og-image.svg",
          "/index.html",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "blog-index",
      "urls": ["/blog-index.json", "/blog/**"],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "365d",
        "strategy": "performance"
      }
    },
    {
      "name": "thematic-index",
      "urls": ["/thematic-index.json"],
      "cacheConfig": {
        "maxSize": 2,
        "maxAge": "365d",
        "strategy": "performance"
      }
    },
    {
      "name": "quran-corpus",
      "urls": ["/quran-full.json"],
      "cacheConfig": {
        "maxSize": 5,
        "maxAge": "365d",
        "strategy": "performance"
      }
    },
    {
      "name": "tafsir-cdn",
      "urls": ["https://cdn.jsdelivr.net/gh/spa5k/tafsir_api@main/tafsir/**"],
      "cacheConfig": {
        "maxSize": 120,
        "maxAge": "30d",
        "strategy": "performance",
        "timeout": "10s"
      }
    },
    {
      "name": "tafsir-local",
      "urls": ["/tafsir/**"],
      "cacheConfig": {
        "maxSize": 120,
        "maxAge": "365d",
        "strategy": "performance"
      }
    }
  ]
}
