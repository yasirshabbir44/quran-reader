ayer","ur":"نماز / صلاۃ","ar":"صلاة"}},{"id":"zakat","arabic":"زَكَوٰة","transliteration":"zakāh","meaning":{"en":"Almsgiving / purification","ur":"زکوٰۃ","ar":"زكاة"}},{"id":"jannah","arabic":"جَنَّة","transliteration":"jannah","meaning":{"en":"Garden / Paradise","ur":"جنت","ar":"جنة"}},{"id":"nar","arabic":"نَار","transliteration":"nār","meaning":{"en":"Fire / Hellfire","ur":"آگ / جہنم","ar":"نار"}},{"id":"yawm","arabic":"يَوْم","transliteration":"yawm","meaning":{"en":"Day","ur":"دن","ar":"يوم"}},{"id":"sama","arabic":"سَمَآء","transliteration":"samāʾ","meaning":{"en":"Sky / heaven","ur":"آسمان","ar":"سماء"}},{"id":"ard","arabic":"أَرْض","transliteration":"arḍ","meaning":{"en":"Earth / land","ur":"زمین","ar":"أرض"}},{"id":"insan","arabic":"إِنسَـٰن","transliteration":"insān","meaning":{"en":"Human / mankind","ur":"انسان","ar":"إنسان"}},{"id":"qalb","arabic":"قَلْب","transliteration":"qalb","meaning":{"en":"Heart","ur":"دل","ar":"قلب"}},{"id":"haqq","arabic":"حَقّ","transliteration":"ḥaqq","meaning":{"en":"Truth / right","ur":"حق","ar":"حق"}},{"id":"nur","arabic":"نُور","transliteration":"nūr","meaning":{"en":"Light","ur":"نور","ar":"نور"}},{"id":"ilm","arabic":"عِلْم","transliteration":"ʿilm","meaning":{"en":"Knowledge","ur":"علم","ar":"علم"}},{"id":"sabr","arabic":"صَبْر","transliteration":"ṣabr","meaning":{"en":"Patience","ur":"صبر","ar":"صبر"}},{"id":"shukr","arabic":"شُكْر","transliteration":"shukr","meaning":{"en":"Gratitude / thanks","ur":"شکر","ar":"شكر"}},{"id":"tawba","arabic":"تَوْبَة","transliteration":"tawbah","meaning":{"en":"Repentance","ur":"توبہ","ar":"توبة"}},{"id":"dhikr","arabic":"ذِكْر","transliteration":"dhikr","meaning":{"en":"Remembrance","ur":"ذکر","ar":"ذكر"}},{"id":"dua","arabic":"دُعَآء","transliteration":"duʿāʾ","meaning":{"en":"Supplication / prayer","ur":"دعا","ar":"دعاء"}},{"id":"malak","arabic":"مَلَك","transliteration":"malak","meaning":{"en":"Angel","ur":"فرشتہ","ar":"ملك"}},{"id":"rasul","arabic":"رَسُول","transliteration":"ra